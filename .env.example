# Copy to .env (never commit .env). Every value is optional: with nothing set, `docker compose up`
# runs the full stack locally with free models (sherpa-onnx speech recognition, Kokoro voices,
# 3D avatar). Only the LLM needs a choice: without one, interview questions are flagged backup
# questions. See NEEDS_FROM_KASHYAP.md for which keys unlock what.

# ---------------------------------------------------------------- interviewer LLM
# anthropic | gemini | ollama | openai_compat | openai | mistral | none
LLM_PROVIDER=none
LLM_MODEL=                     # empty = provider default (anthropic: claude-opus-5-5, gemini: gemini-2.5-flash)
LLM_FALLBACK_PROVIDER=         # optional second provider, used when the first fails
LLM_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Ollama / vLLM / LM Studio / Groq / OpenRouter (OpenAI-compatible). With
# `docker compose --profile local-llm up`, set LLM_PROVIDER=ollama and keep these defaults.
OPENAI_COMPAT_BASE_URL=http://ollama:11434/v1
OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
OPENAI_COMPAT_API_KEY=

# ---------------------------------------------------------------- speech
STT_PROVIDER=sherpa            # sherpa (local, free) | deepgram | none
TTS_PROVIDER=kokoro            # kokoro (local, free) | polly | elevenlabs | none
MODELS_DIR=                    # where local speech models live (compose: /models volume)
STT_THREADS=2
TTS_THREADS=2
TTS_SPEED=1.0
TURN_SILENCE_MS=1000           # pause that ends the candidate's turn
TURN_SILENCE_TRAILING_MS=1800  # longer pause when the answer trails off ("and", "so", "um")
SPEECH_WARMUP=1                # load speech models at startup
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-IN
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
AWS_REGION=ap-south-1          # Polly (TTS_PROVIDER=polly) uses the standard AWS credential chain
POLLY_ENGINE=neural

# ---------------------------------------------------------------- app
APP_ENV=development            # development | production
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000     # web server -> API (server side)
PUBLIC_API_URL=http://localhost:8000   # browser -> API realtime WebSocket (and the CSP allows it)
REALTIME_SECRET=               # HMAC key for WebSocket tickets; set the same value on every API replica
DATABASE_URL=                  # empty = SQLite; compose uses Postgres
SITE_PASSWORD=                 # private previews: HTTP Basic auth on the whole web app
API_SHARED_SECRET=             # set on web AND api when the API has its own public URL
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_MULTIPLIER=1
ADMIN_EMAILS=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- biometrics (optional, consent-gated)
# 32 random bytes, base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TEMPLATE_KEK_BASE64=
TEMPLATE_KMS_KEY=              # production: Cloud KMS key name instead of a local KEK
FACE_EMBEDDER=none             # none | onnx | rekognition
FACE_ONNX_MODEL_PATH=
SPEAKER_EMBEDDER=none          # none | speechbrain_ecapa | resemblyzer
FACE_MATCH_THRESHOLD=          # from eval calibration; empty = verification disabled
VOICE_MATCH_THRESHOLD=
SCORING_CALIBRATED=false       # true only after human-rater validation (docs/EVAL.md)

# ---------------------------------------------------------------- code execution, billing, ops
JUDGE0_URL=http://localhost:2358
JUDGE0_RAPIDAPI_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRICE_TABLE_JSON=
SENTRY_DSN=
SENTRY_TRACES=0
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
NEURAL_AVATAR_URL=             # optional photoreal avatar service (see docs/DECISIONS.md D4)
