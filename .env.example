# Copy to .env for local development. Never commit .env.
# Every value below is optional in OFFLINE mode (APP_MODE=offline), which uses
# the deterministic question bank, browser TTS and no paid vendors.

APP_ENV=development            # development | production
APP_MODE=offline               # offline | live
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database (SQLite is used when unset; Postgres in production)
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview

# Encryption of biometric templates (32 random bytes, base64). Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TEMPLATE_KEK_BASE64=
BIOMETRIC_RETENTION_DAYS=30
RAW_MEDIA_RETENTION_DAYS=0     # 0 = raw media never stored unless user opts in

# LLM provider: anthropic | openai | mistral | none
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Speech
ASR_PROVIDER=browser           # browser | deepgram | faster_whisper
DEEPGRAM_API_KEY=
TTS_PROVIDER=browser           # browser | polly
AWS_REGION=ap-south-1

# Face / voice models (commercially licensed model files only; see MODEL_CARDS/)
FACE_EMBEDDER=none             # none | onnx | rekognition
FACE_ONNX_MODEL_PATH=
SPEAKER_EMBEDDER=none          # none | speechbrain_ecapa | resemblyzer
FACE_MATCH_THRESHOLD=          # set from eval calibration; empty = verification disabled
VOICE_MATCH_THRESHOLD=

# Code execution
JUDGE0_URL=http://localhost:2358
JUDGE0_RAPIDAPI_KEY=           # only for the hosted RapidAPI Judge0

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Feature flags
FEATURE_B2B_HIRING=false       # see COMPLIANCE.md before enabling
FEATURE_NEURAL_AVATAR=false
NEURAL_AVATAR_URL=

# Rate limiting: number of trusted proxies in front of the API (Vercel -> Cloud Run = 2); 0 = socket peer
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_MULTIPLIER=1
