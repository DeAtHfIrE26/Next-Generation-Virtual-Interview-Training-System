# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
apps/web/playwright-report/
apps/web/test-results/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key

# Data that must never be committed (biometrics, recordings, session output)
eval/data/
eval/out/
/data/
/media/
*.wav
*.mp4
*.webm
/reports/
/logs/
/temp/
legacy/*/reports/
legacy/*/logs/
legacy/*/temp/
services/api/var/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Web vision assets (downloaded at install)
apps/web/public/vision/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo
/.models/

# 3D and voice runtimes copied from node_modules at install (scripts/vendor-3d.mjs)
apps/web/public/vendor/
!apps/web/tests/fixtures/speech/*.wav
